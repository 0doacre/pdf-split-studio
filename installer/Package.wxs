<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="PDF Split Studio"
           Manufacturer="Sylvain Golder"
           Version="1.0.0"
           UpgradeCode="7E9A34C1-28B9-4C8D-9E13-68D72A4E90B1"
           Scope="perUserOrMachine">

    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de PDF Split Studio est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PDF Split Studio" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcut" Guid="A34E7B29-1F88-4F8A-9A2E-4D6C789B10E2">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="PDF Split Studio"
                  Description="Logiciel de découpe et fusion de PDF 100% hors-ligne"
                  Target="[INSTALLFOLDER]PDF_Split_Studio.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\PDFSplitStudio" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="F1A8C92B-3D7E-4E6A-8B1C-2E3F4A5B6C7D">
        <Shortcut Id="DesktopShortcut"
                  Name="PDF Split Studio"
                  Description="Logiciel de découpe et fusion de PDF 100% hors-ligne"
                  Target="[INSTALLFOLDER]PDF_Split_Studio.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\PDFSplitStudio" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Icon Id="AppIcon" SourceFile="C:\projets\PDF split\assets\app_icon.ico" />

    <Feature Id="MainFeature" Title="PDF Split Studio" Level="1">
      <Files Directory="INSTALLFOLDER" Include="C:\projets\PDF split\dist\PDF_Split_Studio\**" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Package>
</Wix>
